  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Carter\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+1-555-0100\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"acceptedTerms\": true\n}"
            },
            "url": "{{base_url}}/auth/register",
            "description": "Create a member account. Sample success: {\"success\":true,\"data\":{\"user\":{\"id\":1},\"accessToken\":\"jwt\",\"refreshToken\":\"jwt\"}}"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{base_url}}/auth/login",
            "description": "Login for member or admin. Sample success: {\"success\":true,\"data\":{\"user\":{\"role\":\"admin\"},\"accessToken\":\"jwt\",\"refreshToken\":\"jwt\"}}"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/logout",
            "description": "Logout and revoke refresh token. Sample success: {\"success\":true,\"message\":\"Logged out\"}"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/auth/refresh-token",
            "description": "Rotate access token. Sample success: {\"success\":true,\"data\":{\"accessToken\":\"jwt\",\"refreshToken\":\"jwt\"}}"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": "{{base_url}}/auth/forgot-password",
            "description": "Send reset OTP. Sample success: {\"success\":true,\"data\":{\"emailMasked\":\"j***@example.com\"}}"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"purpose\": \"password_reset\"\n}"
            },
            "url": "{{base_url}}/auth/verify-otp",
            "description": "Verify OTP before reset. Sample success: {\"success\":true,\"data\":{\"verified\":true}}"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewPassword123!\",\n  \"confirmPassword\": \"NewPassword123!\"\n}"
            },
            "url": "{{base_url}}/auth/reset-password",
            "description": "Reset password with OTP. Sample success: {\"success\":true,\"message\":\"Password reset successfully\"}"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"BetterPassword123!\",\n  \"confirmPassword\": \"BetterPassword123!\"\n}"
            },
            "url": "{{base_url}}/auth/change-password",
            "description": "Change password while logged in. Sample success: {\"success\":true,\"message\":\"Password changed\"}"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/auth/me",
            "description": "Fetch current session user. Sample success: {\"success\":true,\"data\":{\"user\":{\"id\":1,\"role\":\"member\"}}}"
          }
        }
      ]
    },
